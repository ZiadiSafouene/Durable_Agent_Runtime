# Copy to .env and replace placeholders. Never commit real credentials.
DATABASE_URL=mysql+asyncmy://durable:durable@127.0.0.1:3306/durable_agent
DATABASE_SYNC_URL=mysql+pymysql://durable:durable@127.0.0.1:3306/durable_agent
TEST_DATABASE_URL=mysql+asyncmy://durable:durable@127.0.0.1:3306/durable_agent_test
TEST_DATABASE_SYNC_URL=mysql+pymysql://durable:durable@127.0.0.1:3306/durable_agent_test

LEASE_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=0.4
WORKER_HEARTBEAT_SECONDS=10
MAX_TOOL_ATTEMPTS=3
SNAPSHOT_EVERY_EVENTS=50
EMBEDDED_WORKER=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
